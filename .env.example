# Copy to .env and fill in. Every value here ships inside the app, so only
# public keys belong in it — never the Supabase secret / service_role key.

# Supabase dashboard → Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud → Google Auth Platform → Clients
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com

# The app's bundle identifier (iOS) / package name (Android)
APP_BUNDLE_ID=com.example.app

# expo.dev → your project → Project ID
EAS_PROJECT_ID=
