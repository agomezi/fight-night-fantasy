# Copy to supabase/functions/.env and fill in. These are server-side secrets
# for Edge Functions — they never go in the app's root .env, which ships in the
# app bundle. Upload them with:
#   npx supabase secrets set --env-file supabase/functions/.env

# Base URL of the UFC stats feed, without a trailing slash (see the private
# planning notes; never commit it)
UFC_FEED_BASE_URL=

# Any long random string. The same value goes in Vault as `card_sync_secret`
# so pg_cron can call the function.
CARD_SYNC_SECRET=

# Optional. API-Sports MMA key for fighter photos; without it the sync skips
# photos. Free plan: 100 requests/day — a full sync uses at most 20 — and only
# dates from yesterday to tomorrow, so photos arrive the day before each card.
APISPORTS_KEY=
# Set to `paid` on a paid plan to fetch every upcoming card's photos at once.
APISPORTS_PLAN=free
